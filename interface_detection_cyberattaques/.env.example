GMAIL_ENABLED=true
GMAIL_SENDER=votre.adresse@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587

# Parametres facultatifs de securite
AUTH_SESSION_HOURS=12
EMAIL_CODE_DURATION_MINUTES=10
EMAIL_CODE_RESEND_SECONDS=60
AUTH_ALLOW_ADDITIONAL_REGISTRATION=false

# Origines et noms d'hôte autorisés par l'API locale
API_ALLOWED_ORIGINS=https://localhost
API_ALLOWED_HOSTS=api,localhost,127.0.0.1
API_DOCS_ENABLED=false

# Limites strictes des imports manuels
MAX_CSV_UPLOAD_MB=200
MAX_EVE_UPLOAD_MB=64
