{
    admin off
    auto_https disable_redirects
    # Le certificat racine est approuve explicitement par le lanceur Windows.
    # Caddy ne tente donc pas de modifier le magasin de confiance du conteneur
    # en lecture seule.
    local_certs
    skip_install_trust
}

https://localhost:8443 {
    header {
        -Server
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    @root path /
    redir @root /SCA/ 308

    @sca_without_slash path /SCA
    redir @sca_without_slash /SCA/ 308

    handle /SCA/* {
        reverse_proxy dashboard:8501
    }

    respond "Ressource introuvable" 404
}
