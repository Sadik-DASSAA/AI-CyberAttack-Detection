# ============================================================
# NOTIFICATIONS GMAIL
# ============================================================
GMAIL_ENABLED=true
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SENDER=votre.adresse@gmail.com
GMAIL_RECIPIENT=destinataire@gmail.com
# Utiliser le mot de passe d'application Gmail de 16 caracteres.
# Ne jamais utiliser le mot de passe normal du compte Google.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ============================================================
# NOTIFICATIONS SMS - TWILIO
# ============================================================
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=votre_auth_token_twilio
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# Format international E.164. Exemple Maroc : +2126XXXXXXXX
SMS_RECIPIENT=+2126XXXXXXXX
